APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 2026-11-08: PostgreSQL (SQLite locks up under several simultaneous
# writers -- web requests + queue workers + many demo visitors).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=me
DB_USERNAME=me
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- NVIDIA NIM (LLM inference) ---------------------------------------
# Get your key at https://build.nvidia.com — sign in, pick a model, click "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_EMBEDDING=nvidia/nemotron-3-embed-1b
# Coach replies follow long, nuanced instructions -- a bigger model sounds far less flat.
# Breakdowns (JSON extraction) stay on the fast NVIDIA_MODEL above.
NVIDIA_MODEL_COACH=nvidia/nemotron-3-ultra-550b-a55b

# --- Crisis contact (mockup/demo only — see config/crisis.php) --------
# This is NOT a real crisis line. For this academic mockup, crisis mode's
# resource text points at your own name/number instead of a verified
# hotline — set your real number here, in your own untracked .env, never
# in this example file or anywhere committed.
CRISIS_CONTACT_NAME=me
CRISIS_CONTACT_NUMBER=

# --- Public demo (see config/demo.php) --------------------------------
# true only on the hosted portfolio demo. Enables POST /api/demo/login,
# the nightly demo:reset, the AI rate cap for demo users, and hides
# CRISIS_CONTACT_NUMBER from the crisis message.
DEMO_MODE=false
DEMO_AI_PER_HOUR=15
DEMO_ENTRIES=3
DEMO_AI_PER_HOUR_PER_NETWORK=300
DEMO_MAX_SANDBOXES_PER_IP=150
DEMO_LOGINS_PER_MINUTE=60
# Your own account for /admin (create it with: php artisan admin:create)
ADMIN_EMAIL=
# Blocked prompt-injection attempts email ADMIN_EMAIL at most once per account per N minutes
INJECTION_MAIL_COOLDOWN=10
