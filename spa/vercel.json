{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://me-demo.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://me-demo.onrender.com/sanctum/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
